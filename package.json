  "dependencies": {
    "element-plus": "^2.14.7",
    "minecraft-map-renderer": "file:lib/minecraft_map_renderer/web",
    "prettier": "^3.9.10",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "globals": "^17.13.0",
    "sass": "^1.106.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
