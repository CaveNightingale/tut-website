{
  "name": "tut",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run static-map && vite",
    "build": "npm run static-map && npm run bluemap && vue-tsc -b && vite build",
    "preview": "vite preview",
    "pretty": "prettier -c prettier.config.json --write .",
